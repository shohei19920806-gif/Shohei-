# このファイルを .env にコピーして値を埋めてください。
# .env は絶対にGitにコミットしないこと（.gitignoreで除外済み）。

# --- Google Search Console ---
# サービスアカウントJSONキーのパス
GSC_CREDENTIALS_JSON=credentials/gsc_service_account.json
# 例: https://example.com/ または sc-domain:example.com
GSC_SITE_URL=

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=
# 未指定時は claude-opus-5。コスト重視なら claude-sonnet-5 等に変更可
ANTHROPIC_MODEL=claude-opus-5

# --- WordPress ---
# 例: https://example.com （末尾スラッシュ不要）
WP_BASE_URL=
WP_USERNAME=
# WordPress管理画面 > ユーザー > プロフィール で発行する「アプリケーションパスワード」
WP_APP_PASSWORD=

# --- X (Twitter) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Instagram ---
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- 楽天アフィリエイト（商品検索API） ---
# 楽天ウェブサービス(https://webservice.rakuten.co.jp/)で発行するアプリID
RAKUTEN_APP_ID=
# 楽天アフィリエイト(https://affiliate.rakuten.co.jp/)のアフィリエイトID
# 未設定でも動作するが、その場合はリンクに成果(報酬)が付与されない
RAKUTEN_AFFILIATE_ID=
